FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        git \
        ca-certificates \
        bash \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --shell /bin/bash sandbox

WORKDIR /workspace
RUN chown sandbox:sandbox /workspace

USER sandbox

CMD ["sleep", "infinity"]
